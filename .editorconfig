# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
# Matches [tool.ruff] line-length in pyproject.toml.
max_line_length = 100

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

# KiCad writes these itself; never reformat them.
[*.{kicad_pcb,kicad_sch,kicad_pro,kicad_mod,kicad_sym}]
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false
